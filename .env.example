APP_NAME=gudangku
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Hash password. 12 cukup untuk lokal, boleh diturunkan saat testing.
BCRYPT_ROUNDS=12

# Log. Di produksi pakai LOG_CHANNEL=stderr dan LOG_LEVEL=warning.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database MySQL. Aplikasi memakai user khusus, bukan root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gudangku
DB_USERNAME=gudangku
DB_PASSWORD=ganti_dengan_password_kuat

# Session disimpan di database supaya tidak hilang saat server restart.
SESSION_DRIVER=database

# Idle timeout: sesi berakhir setelah sekian menit tanpa aktivitas.
SESSION_LIFETIME=60

# Absolute timeout: batas maksimum sejak login, berapa pun aktivitasnya.
# Dipakai middleware App\Http\Middleware\EnsureSessionIsFresh.
SESSION_ABSOLUTE_LIFETIME=720

# Menutup browser berarti sesi berakhir. Cocok untuk perangkat bersama di outlet.
SESSION_EXPIRE_ON_CLOSE=true

# Payload sesi dienkripsi di database.
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null
# Set true hanya di produksi yang sudah memakai HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Aplikasi tidak mengirim email. Notifikasi cukup lewat pesan di dalam aplikasi.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@gudangku.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
